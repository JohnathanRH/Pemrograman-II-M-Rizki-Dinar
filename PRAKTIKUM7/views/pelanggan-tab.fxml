<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.* ?>
<?import javafx.scene.layout.* ?>

<AnchorPane fx:controller="controllers.PelangganController" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
    <children>
        <VBox layoutX="14.0" layoutY="14.0" prefHeight="423.0" prefWidth="574.0">
            <children>
                <VBox maxWidth="-Infinity" prefHeight="189.0" prefWidth="317.0">
                    <children>
                        <GridPane maxWidth="-Infinity" prefHeight="140.0" prefWidth="361.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" maxWidth="102.0" minWidth="10.0" prefWidth="86.0" />
                                <ColumnConstraints hgrow="SOMETIMES" maxWidth="201.0" minWidth="10.0" prefWidth="179.0" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints maxHeight="48.0" minHeight="10.0" prefHeight="48.0" vgrow="SOMETIMES" />
                                <RowConstraints maxHeight="47.0" minHeight="10.0" prefHeight="47.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                            </rowConstraints>
                            <children>
                                <Label text="Nama" />
                                <TextField fx:id="namaPelangganTxt" GridPane.columnIndex="1" />
                                <Label text="Email" GridPane.rowIndex="1" />
                                <TextField fx:id="emailPelangganTxt" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                <Label layoutX="10.0" layoutY="26.0" text="Telepon" GridPane.rowIndex="2" />
                                <TextField fx:id="teleponPelangganTxt" layoutX="10.0" layoutY="22.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                            </children>
                        </GridPane>
                        <Separator prefWidth="200.0" />
                        <HBox prefHeight="36.0" prefWidth="311.0" spacing="20.0">
                            <children>
                                <Button fx:id="addPelangganBtn" layoutX="10.0" layoutY="10.0" mnemonicParsing="false" onAction="#onAddPelanggan" text="Add" textFill="#1a9000" />
                                <Button fx:id="editPelangganBtn" onAction="#onEditPelanggan" mnemonicParsing="false" text="Edit" textFill="#a4a200" />
                                <Button fx:id="deletePelangganBtn" onAction="#onDeletePelanggan" layoutX="62.0" layoutY="10.0" mnemonicParsing="false" text="Delete" textFill="#dd0000" />
                                <Button fx:id="clearPelangganBtn" onAction="#clearField" layoutX="62.0" layoutY="10.0" mnemonicParsing="false" text="Clear" textFill="#000000" />
                            </children>
                            <VBox.margin>
                                <Insets top="10.0" />
                            </VBox.margin>
                        </HBox>
                    </children>
                </VBox>
                <TableView fx:id="pelangganTbl" prefHeight="214.0" prefWidth="574.0">
                    <columns>
                        <TableColumn fx:id="namaCol" prefWidth="186.0" text="Nama" />
                        <TableColumn fx:id="emailCol" prefWidth="175.0" text="Email" />
                        <TableColumn fx:id="teleponCol" prefWidth="212.0" text="Telepon" />
                    </columns>
                </TableView>
            </children>
        </VBox>
    </children>
</AnchorPane>