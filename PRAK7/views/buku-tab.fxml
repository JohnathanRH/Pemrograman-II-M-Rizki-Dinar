<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.* ?>
<?import javafx.scene.layout.* ?>

<AnchorPane fx:controller="controllers.BukuController" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
    <children>
        <VBox layoutX="14.0" layoutY="14.0" prefHeight="423.0" prefWidth="574.0">
            <children>
                <VBox maxWidth="-Infinity" prefHeight="287.0" prefWidth="312.0">
                    <children>
                        <GridPane maxWidth="-Infinity" prefHeight="183.0" prefWidth="312.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" maxWidth="102.0" minWidth="10.0" prefWidth="86.0" />
                                <ColumnConstraints hgrow="SOMETIMES" maxWidth="201.0" minWidth="10.0" prefWidth="179.0" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints maxHeight="48.0" minHeight="10.0" prefHeight="48.0" vgrow="SOMETIMES" />
                                <RowConstraints maxHeight="47.0" minHeight="10.0" prefHeight="47.0" vgrow="SOMETIMES" />
                                <RowConstraints maxHeight="55.0" minHeight="10.0" prefHeight="55.0" vgrow="SOMETIMES" />
                                <RowConstraints maxHeight="34.0" minHeight="7.0" prefHeight="14.0" vgrow="SOMETIMES" />
                            </rowConstraints>
                            <children>
                                <Label text="Judul" />
                                <TextField fx:id="judulBukuTxt" GridPane.columnIndex="1" />
                                <Label text="Penulis" GridPane.rowIndex="1" />
                                <TextField fx:id="penulisBukuTxt" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                <Label layoutX="10.0" layoutY="26.0" text="Harga" GridPane.rowIndex="2" />
                                <TextField fx:id="hargaBukuTxt" layoutX="10.0" layoutY="22.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                <Label layoutX="10.0" layoutY="120.0" prefHeight="42.0" prefWidth="24.0" text="Stok" GridPane.rowIndex="3" />
                                <TextField fx:id="stokBukuTxt" layoutX="112.0" layoutY="116.0" maxHeight="-Infinity" prefHeight="0.0" prefWidth="201.0" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                            </children>
                        </GridPane>
                        <Separator prefWidth="200.0">
                            <VBox.margin>
                                <Insets bottom="10.0" top="10.0" />
                            </VBox.margin>
                        </Separator>
                        <HBox prefHeight="36.0" prefWidth="311.0" spacing="20.0">
                            <children>
                                <Button fx:id="addBukuBtn" onAction="#onAddBuku" layoutX="10.0" layoutY="10.0" mnemonicParsing="false" text="Add" textFill="#1a9000" />
                                <Button fx:id="editBukuBtn" onAction="#onEditBuku" mnemonicParsing="false" text="Edit" textFill="#a4a200" />
                                <Button fx:id="deleteBukuBtn" onAction="#onDeleteBuku" layoutX="62.0" layoutY="10.0" mnemonicParsing="false" text="Delete" textFill="#dd0000" />
                            </children>
                            <VBox.margin>
                                <Insets />
                            </VBox.margin>
                        </HBox>
                    </children>
                </VBox>
                <TableView fx:id="bukuTbl" prefHeight="214.0" prefWidth="574.0">
                    <columns>
                        <TableColumn fx:id="judulCol" prefWidth="129.0" text="Judul" />
                        <TableColumn fx:id="penulisCol" minWidth="0.0" prefWidth="132.0" text="Penulis" />
                        <TableColumn fx:id="hargaCol" prefWidth="170.0" text="Harga" />
                        <TableColumn fx:id="stokCol" prefWidth="142.0" text="Stok" />
                    </columns>
                </TableView>
            </children>
        </VBox>
    </children>
</AnchorPane>